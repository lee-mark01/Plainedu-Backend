{
  "name": "plainedu-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node -r dotenv/config node_modules/db-migrate/bin/db-migrate up --config database.json --migrations-dir db/migrations",
    "migrate:down": "node -r dotenv/config node_modules/db-migrate/bin/db-migrate down --config database.json --migrations-dir db/migrations",
    "seed:stocks": "node db/seeds/seed-stocks.js",
    "seed:users": "node db/seeds/seed-users.js",
    "seed:demo": "node db/seeds/seed-demo.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "check:openapi": "node scripts/check-openapi.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.16.0",
    "cors": "^2.8.6",
    "db-migrate": "^0.11.14",
    "db-migrate-mysql": "^3.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
