{
  "name": "plainedu-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node -r dotenv/config node_modules/.bin/db-migrate up --config database.json --migrations-dir db/migrations",
    "migrate:down": "node -r dotenv/config node_modules/.bin/db-migrate down --config database.json --migrations-dir db/migrations",
    "seed:stocks": "node db/seeds/seed-stocks.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.16.0",
    "cors": "^2.8.6",
    "db-migrate": "^0.11.14",
    "db-migrate-mysql": "^3.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.3",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
